[Unit]
Description=Ubuntu desktops custom KVM LAN isolation guard
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=KVM_BRIDGE_NAME=virbr50
Environment=KVM_NETWORK_CIDR=192.168.50.0/24
ExecStart=/usr/local/libexec/ubuntu-desktops-custom/kvm-network-guard apply
ExecReload=/usr/local/libexec/ubuntu-desktops-custom/kvm-network-guard reload
ExecStop=/usr/local/libexec/ubuntu-desktops-custom/kvm-network-guard remove

[Install]
WantedBy=multi-user.target
