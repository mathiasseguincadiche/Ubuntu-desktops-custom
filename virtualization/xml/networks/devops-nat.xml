<!-- Declarative libvirt network template. Not applied automatically. -->
<!-- DNS upstream policy (9.9.9.9 / 1.1.1.1) and physical-LAN isolation are
     enforced by the future network module after preflight; they are not
     represented here as unsafe host-wide firewall assumptions. -->
<!-- Stable VM DHCP <host> reservations are injected/generated later from
     deterministic VM identities after conflict validation. -->
<network>
  <name>devops-nat</name>
  <forward mode='nat'/>
  <bridge name='virbr50' stp='on' delay='0'/>
  <ip address='192.168.50.254' netmask='255.255.255.0'>
    <dhcp>
      <range start='192.168.50.100' end='192.168.50.200'/>
    </dhcp>
  </ip>
</network>
